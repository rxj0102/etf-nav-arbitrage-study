# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit credentials.

# --- FRED (https://fred.stlouisfed.org/docs/api/api_key.html) ---
FRED_API_KEY=

# --- Alert threshold override (optional, defaults to 2.0) ---
ALERT_THRESHOLD=

# --- Email channel (Gmail-compatible SMTP) ---
# Set EMAIL_ENABLED=true to activate. For Gmail use an App Password:
# https://support.google.com/accounts/answer/185833
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated list of recipients
ALERT_EMAIL_TO=

# --- Slack channel (incoming webhook) ---
# Set SLACK_ENABLED=true to activate.
# Create a webhook: https://api.slack.com/messaging/webhooks
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Dashboard link embedded in alerts ---
DASHBOARD_URL=http://localhost:8501
